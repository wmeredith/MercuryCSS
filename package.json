{
  "name": "mercurycss",
  "version": "1.0.2",
  "description": "A fast classless stylesheet boilerplate focused on typography.",
  "license": "MIT",
  "author": "Wade Meredith | wademeredith.com",
  "homepage": "https://wmeredith.github.io/MercuryCSS/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmeredith/MercuryCSS.git"
  },
  "bugs": {
    "url": "https://github.com/wmeredith/MercuryCSS/issues"
  },
  "style": "dist/mercury.css",
  "files": [
    "dist",
    "scss",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "sass scss/mercury.scss dist/mercury.css --no-source-map",
    "build:min": "sass scss/mercury.scss dist/mercury.min.css --style=compressed --no-source-map",
    "build:dist": "npm run build && npm run build:min",
    "test": "echo \"No tests\""
  }
}
